{
  "name": "packdev",
  "version": "0.1.3",
  "description": "PackDev - A TypeScript-based CLI tool for managing package dependencies during development using local paths or git repositories",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "packdev": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "cd test && node run-all-tests.js",
    "test:unit": "cd test && node unit/packageManager.test.js",
    "test:integration": "cd test && node run-all-tests.js --integration-only",
    "test:unit-only": "cd test && node run-all-tests.js --unit-only",
    "test:docker": "bash test/docker/run.sh",
    "test-demo": "cd test && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepare": "npm run build",
    "pack": "node scripts/pack.js",
    "pack:bash": "scripts/pack.sh",
    "test-install": "node scripts/test-install.js",
    "package-info": "node scripts/package-info.js",
    "test-hooks": "node scripts/test-hooks.js",
    "demo-hooks": "node scripts/demo-hooks.js",
    "demo-workflow": "node scripts/demo-workflow.js",
    "validate-docs": "node scripts/validate-docs.js"
  },
  "keywords": [
    "cli",
    "typescript",
    "development",
    "package",
    "tools"
  ],
  "author": "Dion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dionmaicon/packdev.git"
  },
  "bugs": {
    "url": "https://github.com/dionmaicon/packdev/issues"
  },
  "homepage": "https://github.com/dionmaicon/packdev#readme",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/commander": "^2.12.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "commander": "^14.0.1"
  }
}
